// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model carrito {
  id       Int    @id @default(autoincrement())
  nombre   String
  precio   Float
  cantidad Int
}

model Encuestas {
  id       Int      @id @default(autoincrement())
  pregunta String
  opciones Opcion[]
}

model Opcion {
  id         Int       @id @default(autoincrement())
  texto      String
  votos      Int       @default(0)
  encuestaId Int
  encuesta   Encuestas @relation(fields: [encuestaId], references: [id], onDelete: Cascade)
}

model Inventario {
  id          Int    @id @default(autoincrement())
  producto    String
  stock       Int    @default(0)
  stockMinimo Int    @default(5)
}

model Turnos {
  id       Int    @id @default(autoincrement())
  cliente  String
  servicio String
  estado   String @default("esperando")
}

model Habito {
  id          Int        @id @default(autoincrement())
  nombre      String
  meta        String
  registros   Registro[]
}

model Registro {
  id          Int      @id @default(autoincrement())
  fecha       String   // Formato "YYYY-MM-DD"
  completado  Boolean  @default(true)
  habitoId    Int
  habito      Habito   @relation(fields: [habitoId], references: [id], onDelete: Cascade)
}